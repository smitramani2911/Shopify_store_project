{%- doc -%}
  Renders a breadcrumb trail (Home / collection / current page) with matching BreadcrumbList structured data.
  Product pages show the collection only when the shopper arrived through a collection URL, so the trail
  never invents a category. Renders nothing on the home page.
{%- enddoc -%}

{% liquid
  assign crumb_names = ''
  assign crumb_urls = ''
  assign separator = '|~|'

  case request.page_type
    when 'product'
      if collection != blank
        assign crumb_names = collection.title
        assign crumb_urls = collection.url
      endif
      assign current_title = closest.product.title | default: product.title
    when 'collection'
      assign current_title = collection.title
    when 'page'
      assign current_title = page.title
    when 'blog'
      assign current_title = blog.title
    when 'article'
      assign crumb_names = blog.title
      assign crumb_urls = blog.url
      assign current_title = article.title
    when 'search'
      assign current_title = 'blocks.breadcrumbs.search' | t
    when 'list-collections'
      assign current_title = 'blocks.breadcrumbs.collections' | t
    else
      assign current_title = page_title
  endcase

  assign parent_names = crumb_names | split: separator
  assign parent_urls = crumb_urls | split: separator
  assign home_label = 'blocks.breadcrumbs.home' | t
%}

{% if request.page_type != 'index' and current_title != blank %}
  <nav
    class="breadcrumbs spacing-style"
    style="{% render 'spacing-style', settings: block.settings %} --breadcrumbs-justify: {{ block.settings.alignment }};"
    aria-label="{{ 'blocks.breadcrumbs.label' | t }}"
    {{ block.shopify_attributes }}
  >
    <ol
      class="breadcrumbs__list"
      role="list"
    >
      <li class="breadcrumbs__item">
        <a
          class="breadcrumbs__link"
          href="{{ routes.root_url }}"
        >
          {{- home_label -}}
        </a>
      </li>
      {% for name in parent_names %}
        <li class="breadcrumbs__item">
          <a
            class="breadcrumbs__link"
            href="{{ parent_urls[forloop.index0] }}"
          >
            {{- name | escape -}}
          </a>
        </li>
      {% endfor %}
      <li class="breadcrumbs__item">
        <span
          class="breadcrumbs__current"
          aria-current="page"
        >
          {{- current_title | escape -}}
        </span>
      </li>
    </ol>
  </nav>

  {%- capture breadcrumb_json -%}
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ home_label | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        }
        {%- for name in parent_names -%}
          ,{
            "@type": "ListItem",
            "position": {{ forloop.index | plus: 1 }},
            "name": {{ name | json }},
            "item": {{ request.origin | append: parent_urls[forloop.index0] | json }}
          }
        {%- endfor -%}
        ,{
          "@type": "ListItem",
          "position": {{ parent_names.size | plus: 2 }},
          "name": {{ current_title | json }}
        }
      ]
    }
  {%- endcapture -%}
  <script type="application/ld+json">
    {{ breadcrumb_json | strip_newlines }}
  </script>
{% endif %}

{% stylesheet %}
  .breadcrumbs {
    min-width: 0;
    width: 100%;
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: var(--breadcrumbs-justify, flex-start);
    gap: 0.25rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .breadcrumbs__item + .breadcrumbs__item::before {
    content: '/';
    padding-inline: 0.5em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40, 0.4));
  }

  .breadcrumbs__link {
    color: inherit;
    text-decoration: none;
    padding-block: 0.5rem;
  }

  .breadcrumbs__link:hover {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .breadcrumbs__current {
    color: var(--color-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(60vw, 32rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.breadcrumbs",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.breadcrumbs",
      "category": "t:categories.links"
    }
  ]
}
{% endschema %}
