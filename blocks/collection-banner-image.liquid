{%- doc -%}
  Shows the current collection's own image (Admin > Collections > Collection image) in a collection banner.
  Renders nothing when the collection has no image, so the banner text simply takes the full width.
{%- enddoc -%}

{% liquid
  assign banner_collection = closest.collection | default: collection
  assign banner_image = banner_collection.image
  assign banner_alt = banner_image.alt | default: banner_collection.title
%}

{% if banner_image != blank %}
  <div
    class="collection-banner-image collection-banner-image--{{ block.settings.aspect_ratio }}"
    {{ block.shopify_attributes }}
  >
    {{
      banner_image
      | image_url: width: 1600
      | image_tag:
        widths: '480, 720, 960, 1200, 1600',
        sizes: '(min-width: 990px) 40vw, 100vw',
        loading: 'eager',
        alt: banner_alt,
        class: 'collection-banner-image__img'
    }}
  </div>
{% elsif request.design_mode %}
  <div
    class="collection-banner-image collection-banner-image--{{ block.settings.aspect_ratio }}"
    {{ block.shopify_attributes }}
  >
    {{ 'collection-apparel-1' | placeholder_svg_tag: 'collection-banner-image__img' }}
  </div>
{% endif %}

{% stylesheet %}
  .collection-banner-image {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5, 0.05));
  }

  /* Beside the banner text on larger screens, the image stays secondary to the title. */
  @media screen and (min-width: 750px) {
    .collection-banner-image {
      flex: 0 0 auto;
      width: min(40%, 34rem);
    }
  }

  .collection-banner-image--square {
    aspect-ratio: 1;
  }

  .collection-banner-image--portrait {
    aspect-ratio: 4 / 5;
  }

  .collection-banner-image__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_banner_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.collection_banner_image_info"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:options.landscape"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        }
      ],
      "default": "landscape"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_banner_image",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
