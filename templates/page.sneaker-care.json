          },
          "blocks": {}
        },
        "intro": {
          "type": "text",
          "settings": {
            "text": "<p>Most sneakers mix materials. Treat each part according to what it’s made of, and when in doubt, use less water and a gentler method.</p>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
