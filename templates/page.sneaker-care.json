              ]
            },
            "canvas": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Canvas",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "answer": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Scrub lightly with a soft brush, cold water and a small amount of mild soap. Rinse the brush often and blot excess water with a towel.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
