            },
            "knit": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Knit and mesh",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "answer": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Dab rather than scrub, using a soft brush or cloth with cold water and mild soap. Knit uppers can stretch or pill if they’re rubbed hard.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
